# Copy to .env (same folder) and fill in. Loaded automatically by piaa when the variable is not set in the environment.
# Only the key of the provider you use (--provider / Setup page) is needed.
ANTHROPIC_API_KEY=sk-ant-api03-...
DEEPSEEK_API_KEY=sk-...
