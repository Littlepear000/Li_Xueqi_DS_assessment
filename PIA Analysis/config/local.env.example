# PIA Analysis - local configuration.
# setup.bat copies this to config\local.env on first run. Edit config\local.env, not this file.
#
# The Anthropic API key is NOT stored here. Set it on the Setup page in the browser.

# Local web app port (http://127.0.0.1:<port>). If busy, the next free port up to +10 is used.
PIAA_PORT=18765

# Data locations, relative to this package folder (the folder that contains start.bat).
# Use absolute paths if your data lives elsewhere.
PIAA_RAW=..\raw_data
PIAA_OUT=..\output
